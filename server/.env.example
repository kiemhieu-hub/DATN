# MongoDB Atlas Connection String
# Thay thế bằng URI của bạn từ MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/thads_barber?retryWrites=true&w=majority

# JWT Secret - thay đổi thành chuỗi ngẫu nhiên bảo mật
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Port
PORT=5000

# Email Configuration (Nodemailer) - Tùy chọn
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
